{
  "name": "bucket-hat-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker backing Bucket Hat: Better Auth over D1, gear photos in R2, and the web build served from the same origin.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "versions:upload": "wrangler versions upload",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute bucket-hat --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute bucket-hat --remote --file=./schema.sql",
    "db:auth:local": "wrangler d1 execute bucket-hat --local --file=./auth-schema.sql",
    "db:auth:remote": "wrangler d1 execute bucket-hat --remote --file=./auth-schema.sql"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.6.25",
    "better-auth": "^1.5.0",
    "hono": "^4.6.0",
    "kysely": "^0.29.4",
    "kysely-d1": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.115.0"
  }
}
