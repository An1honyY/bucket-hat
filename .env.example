# Copy this file to .env and fill in real values. Never commit .env itself
# (already in .gitignore). docs/02-external-apis.md §2 has full setup notes
# for each key, including the required Google Cloud budget alert.

# Google Routes API (routes.googleapis.com) — billable, needs a GCP project
# with the Routes API enabled and a budget alert configured before use
# outside local dev (docs/02-external-apis.md §2). Also used for Places API
# (New) address autocomplete (placesService.ts) — enable "Places API (New)"
# on the same GCP project/key rather than creating a second key.
EXPO_PUBLIC_GOOGLE_ROUTES_API_KEY=

# Auckland Transport GTFS Realtime subscription key (dev-portal.at.govt.nz)
# — powers live bus/train delay data (docs/02-external-apis.md §2, Phase 7).
EXPO_PUBLIC_AT_SUBSCRIPTION_KEY=

# CARTO basemaps (basemaps.cartocdn.com) — the web maps' tiles. Optional:
# without it the maps fall back to keyless OpenStreetMap tiles, which work
# but are busier and have no dark style of their own. CARTO used to be
# keyless too; since 2026-08-28 unauthenticated raster tiles come back
# stamped "API KEY REQUIRED". Free key, no account:
# https://carto.com/basemaps/apikey
EXPO_PUBLIC_CARTO_API_KEY=

# Open-Meteo needs no key.
